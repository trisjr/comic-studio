# AI Coding
# .env.example — mau bien moi truong cho MVP0 (provider: Alibaba Model Studio).
#
# Cach dung:
#   1. cp .env.example .env
#   2. Dien gia tri that vao .env (⛔ .env da nam trong .gitignore — KHONG commit)
#   3. Nap vao shell truoc khi chay script:  set -a && source .env && set +a
#
# ⛔ KHONG dien gia tri that vao chinh file nay — file nay duoc commit len git
# (`security.md` §2: secret chi song trong .env).

# API key Alibaba Cloud Model Studio, region SINGAPORE.
# Lay tai: Model Studio console -> API Keys. ⚠️ Key cua region Bac Kinh
# ⛔ KHONG dung duoc voi endpoint quoc te dashscope-intl (hai region tach
# key va endpoint).
DASHSCOPE_API_KEY=

# Gia tham chieu 1 anh (USD) — Founder doc tu bang gia console cho DUNG model
# dang pin trong scripts/mvp0/providers.py. `SRS §5.2` cam bia so ⇒ repo
# khong hardcode gia; de trong thi script van chay, cost_usd ghi null va
# cost_status="reference_price_missing".
#
# Model t2i cho stage `refs` (IMAGE_T2I_MODEL_ID, vi du 0.03):
MVP0_IMAGE_PRICE_T2I_USD=
# Model edit cho stage `panels` (IMAGE_EDIT_MODEL_ID):
MVP0_IMAGE_PRICE_EDIT_USD=


# ===========================================================================
# BACKEND (apps/backend) — MVP1
# ===========================================================================
# ⛔ KHONG dien gia tri that vao file nay. `security.md` §2: secret chi song
# trong `.env`, va `.env` da nam trong `.gitignore`.
#
# Thu tu chay lan dau:
#   1. pnpm db:up                    (postgres + minio bang docker compose)
#   2. pnpm backend db:bootstrap     (tao ba DB role tu bien moi truong)
#   3. pnpm backend migrate          (chay migration duoi role owner)

NODE_ENV=development
LOG_LEVEL=info
APP_PORT=3000
APP_HOST=0.0.0.0

# --- PostgreSQL: bon danh tinh ket noi tach bach cua SDD §7.4 ---------------
# `owner` chay migration va co quyen DDL. Ba role ung dung ⛔ KHONG co DDL.
DATABASE_URL_OWNER=postgres://comic_owner:comic_owner_dev@localhost:5432/comic_studio
DATABASE_URL_API=postgres://app_api:doi_mat_khau_nay@localhost:5432/comic_studio
DATABASE_URL_WORKER=postgres://app_worker:doi_mat_khau_nay@localhost:5432/comic_studio
DATABASE_URL_PUBLIC_INTAKE=postgres://app_public_intake:doi_mat_khau_nay@localhost:5432/comic_studio

# Mat khau ma `db:bootstrap` dat cho ba role tren. Phai khop phan mat khau cua
# ba connection string o tren.
DB_APP_API_PASSWORD=
DB_APP_WORKER_PASSWORD=
DB_APP_PUBLIC_INTAKE_PASSWORD=

# Bien cua chinh container postgres trong compose.yaml
POSTGRES_USER=comic_owner
POSTGRES_PASSWORD=comic_owner_dev
POSTGRES_DB=comic_studio
POSTGRES_PORT=5432

# --- Object storage: MinIO o dev, vendor S3-compatible o production ---------
# ADR-004 dieu 1: code chi noi chuyen voi tap con S3 qua MOT adapter.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=comic-studio
STORAGE_ACCESS_KEY_ID=comic_studio_dev
STORAGE_SECRET_ACCESS_KEY=comic_studio_dev_secret
STORAGE_FORCE_PATH_STYLE=true

# ADR-004 dieu 4: DUNG MOT hang so TTL cho signed URL, ⛔ khong rai nhieu cho.
# ⚠️ Con so that con la `TBD` — Dev de xuat, Founder duyet o MVP1 khi editor co
# luong that de do. Rang buoc da chot: ngan hon TTL phien dang nhap, ⛔ khong vo
# han, ⛔ khong tinh bang ngay.
STORAGE_SIGNED_URL_TTL_SECONDS=300

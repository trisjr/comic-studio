# AI Coding
# .env.example — mau bien moi truong cho MVP0 (provider: Alibaba Model Studio).
#
# Cach dung:
#   1. cp .env.example .env
#   2. Dien gia tri that vao .env (⛔ .env da nam trong .gitignore — KHONG commit)
#   3. Nap vao shell truoc khi chay script:  set -a && source .env && set +a
#
# ⛔ KHONG dien gia tri that vao chinh file nay — file nay duoc commit len git
# (`security.md` §2: secret chi song trong .env).

# API key Alibaba Cloud Model Studio, region SINGAPORE.
# Lay tai: Model Studio console -> API Keys. ⚠️ Key cua region Bac Kinh
# ⛔ KHONG dung duoc voi endpoint quoc te dashscope-intl (hai region tach
# key va endpoint).
DASHSCOPE_API_KEY=

# Gia tham chieu 1 anh (USD) — Founder doc tu bang gia console cho DUNG model
# dang pin trong scripts/mvp0/providers.py. `SRS §5.2` cam bia so ⇒ repo
# khong hardcode gia; de trong thi script van chay, cost_usd ghi null va
# cost_status="reference_price_missing".
#
# Model t2i cho stage `refs` (IMAGE_T2I_MODEL_ID, vi du 0.03):
MVP0_IMAGE_PRICE_T2I_USD=
# Model edit cho stage `panels` (IMAGE_EDIT_MODEL_ID):
MVP0_IMAGE_PRICE_EDIT_USD=

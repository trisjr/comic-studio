{
  "name": "@comic-studio/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Modular monolith: mot image, hai entrypoint api va worker (ADR-001, ADR-002)",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts api",
    "dev:worker": "tsx watch src/main.ts worker",
    "db:bootstrap": "tsx src/main.ts db:bootstrap",
    "migrate": "tsx src/main.ts migrate",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@comic-studio/contracts": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "pg": "^8.16.0",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@comic-studio/tsconfig": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
